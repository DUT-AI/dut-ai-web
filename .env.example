# ========================
# PostgreSQL
# ========================
POSTGRES_DB=wagtail
POSTGRES_USER=wagtail
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ========================
# MinIO (server-only)
# ========================
MINIO_ENDPOINT=minio.example.com
MINIO_PUBLIC_URL=https://minio.example.com
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key
MINIO_BUCKET_NAME=dut-ai-manager
MINIO_SECURE=true

# ========================
# Backend (Wagtail/Django)
# ========================
ALLOWED_HOSTS=yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com
SECRET_KEY=change-me-to-a-random-secret-key

# ========================
# Frontend (Next.js)
# ========================
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
DUT_MANAGER_USERS_URL=https://manage.dutai.io.vn/api/v1/users
DUT_MANAGER_API_KEY=replace-with-server-only-manage-key
REDIS_URL=redis://redis:6379

# ========================
# Ports (optional override)
# ========================
BACKEND_PORT=8000
FRONTEND_PORT=3000
