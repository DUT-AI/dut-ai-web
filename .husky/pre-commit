#!/usr/bin/env bash
set -e

echo "=========================================="
echo "🔍 [Pre-commit] Bắt đầu kiểm tra commit..."
echo "=========================================="

# 1. Chặn commit file chứa thông tin nhạy cảm (.env, .env.local, v.v.)
STAGED_ENV_FILES=$(git diff --cached --name-only | grep -E '(^|/)\.env($|\.local$|\.production$)' || true)
if [ -n "$STAGED_ENV_FILES" ]; then
    echo "❌ [LỖI BẢO MẬT] Phát hiện file môi trường (.env) trong git staged:"
    echo "$STAGED_ENV_FILES"
    echo "👉 Vui lòng chạy: git reset HEAD <file> để bỏ file bí mật trước khi commit!"
    exit 1
fi

# 2. Kiểm tra Frontend nếu có file frontend thay đổi
STAGED_FRONTEND=$(git diff --cached --name-only | grep -E '^frontend/' || true)
if [ -n "$STAGED_FRONTEND" ]; then
    echo "📦 [Frontend] Phát hiện file trong frontend/ thay đổi:"
    
    cd frontend
    
    if [ -d "node_modules" ]; then
        # 2.1 Kiểm tra TypeScript type check
        echo "  ↳ 1/2 Kiểm tra TypeScript (tsc --noEmit)..."
        if ! npx tsc --noEmit; then
            echo "❌ [LỖI] TypeScript type check thất bại trong frontend/!"
            echo "👉 Vui lòng sửa các lỗi TypeScript ở trên trước khi commit."
            exit 1
        fi
        echo "  ✓ TypeScript OK."

        # 2.2 Kiểm tra ESLint
        echo "  ↳ 2/2 Kiểm tra ESLint (npm run lint)..."
        if ! npm run lint; then
            echo "❌ [LỖI] ESLint phát hiện lỗi trong frontend/!"
            echo "👉 Vui lòng chạy 'npm run lint' hoặc sửa lỗi trước khi commit."
            exit 1
        fi
        echo "  ✓ ESLint OK."
    else
        echo "  ⚠️ Chưa tìm thấy frontend/node_modules trên máy host (bạn đang build bằng Docker)."
        echo "  ℹ️ Bỏ qua kiểm tra tsc/eslint trên host. Chạy 'cd frontend && npm i' nếu muốn kiểm tra trực tiếp."
    fi

    cd ..
fi

# 3. Kiểm tra cú pháp Python trong Backend nếu có file python thay đổi
STAGED_BACKEND=$(git diff --cached --name-only | grep -E '^backend/.*\.py$' || true)
if [ -n "$STAGED_BACKEND" ]; then
    echo "🐍 [Backend] Phát hiện file Python thay đổi, đang kiểm tra cú pháp..."
    for py_file in $STAGED_BACKEND; do
        if [ -f "$py_file" ]; then
            if ! python3 -m py_compile "$py_file"; then
                echo "❌ [LỖI] Cú pháp Python bị lỗi trong file: $py_file"
                exit 1
            fi
        fi
    done
    echo "  ✓ Python syntax OK."
fi

echo "=========================================="
echo "✅ [Pre-commit] Tất cả kiểm tra thành công! Cho phép commit."
echo "=========================================="
exit 0
